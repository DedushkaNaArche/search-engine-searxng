use_default_settings: true

general:
  debug: false
  instance_name: "Ded Search"

search:
  safe_search: 0
  autocomplete: "duckduckgo"
  default_lang: "auto"
  formats:
    - html

server:
  secret_key: "change-me-generate-your-own-secret"
  bind_address: "0.0.0.0"
  port: 8080
  limiter: false
  image_proxy: true
  method: "POST"

ui:
  static_use_hash: true
  default_theme: simple
  theme_args:
    simple_style: dark

preferences:
  lock:
    - method
    - autocomplete

outgoing:
  request_timeout: 2.0
  max_request_timeout: 4.0
  pool_connections: 50
  pool_maxsize: 20
  enable_http2: true
